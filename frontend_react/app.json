{
  "expo": {
    "name": "frontend_react",
    "slug": "frontend_react",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

  "android": {
      "package": "com.taskflow.app"
    },
    "ios": {
      "bundleIdentifier": "com.taskflow.app"
    },

  "web": {
    "favicon": "./assets/favicon.png",
    "pwa": {
      "enabled": true,
      "manifest": {
        "name": "TaskFlow",
        "short_name": "TaskFlow",
        "start_url": "/",
        "display": "standalone",
        "background_color": "#121212",
        "theme_color": "#3498db",
        "icons": [
          {
            "src": "./assets/icon.png",
            "sizes": [72, 96, 128, 144, 152, 192, 384, 512],
            "type": "image/png"
          }
        ]
      },
      "serviceWorker": {
        "enabled": true,
        "registrationOptions": { "scope": "/" }
      }
    }
  }
}
}